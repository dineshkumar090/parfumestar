from fastapi import FastAPI, HTTPException, Request
from fastapi.middleware.cors import CORSMiddleware
from fastapi.responses import FileResponse, RedirectResponse
from fastapi.staticfiles import StaticFiles
import logging
import os

from app.routes import evaluation_routes
from app.api.auth import router as auth_router
from app.routes import admin
from app.api import webhooks
from app.database import engine, Base

from app.api.chat_routes import router as chat_router
from app.api.analytics_routes import router as analytics_router
from app.api.sync_routes import router as sync_router
from app.models import chat as _chat_models  # noqa: F401
from app.models import sync_log as _sync_log_models  # noqa: F401
from app.models.chat import EngagementEvent  # noqa: F401 — registers table
from app.routes import prompt_routes

logger = logging.getLogger("uvicorn.error")

app = FastAPI()

# ── API routers (must be registered before SPA catch-all) ─────────────────
app.include_router(evaluation_routes.router)
app.include_router(auth_router)
app.include_router(admin.router, prefix="/api")
app.include_router(webhooks.router)
app.include_router(chat_router)
app.include_router(analytics_router)
app.include_router(prompt_routes.router)
app.include_router(sync_router)


# ── Frontend (React/Vite build) ─────────────────────────────────────────────
def _resolve_frontend_dir() -> str | None:
    """Find AI-Assistant build output (build/ or dist/)."""
    app_dir = os.path.dirname(os.path.abspath(__file__))
    project_root = os.path.dirname(app_dir)
    print("project_root:", project_root)
    print("app_dir:", app_dir)
    candidates = [
        os.path.join(project_root, "AI-Assistant", "build"),
        os.path.join(project_root, "AI-Assistant", "dist"),
        os.path.join(app_dir, "AI-Assistant", "build"),
        os.path.join(app_dir, "AI-Assistant", "dist"),
    ]
    for path in candidates:
        print("path:", path)
        if os.path.isfile(os.path.join(path, "index.html")):
            return path
    return None


FRONTEND_DIR = _resolve_frontend_dir()
if FRONTEND_DIR:
    logger.info("Serving frontend from: %s", FRONTEND_DIR)
    assets_path = os.path.join(FRONTEND_DIR, "assets")
    if os.path.isdir(assets_path):
        app.mount("/assets", StaticFiles(directory=assets_path), name="frontend-assets")
else:
    logger.warning(
        "Frontend build not found. Run: cd AI-Assistant && npm run build"
    )


def _serve_index():
    if not FRONTEND_DIR:
        raise HTTPException(
            status_code=503,
            detail="Frontend not built. Run: cd AI-Assistant && npm run build",
        )
    return FileResponse(
        os.path.join(FRONTEND_DIR, "index.html"),
        media_type="text/html",
    )


# Paths handled by API/backend — SPA catch-all must not swallow these
_BACKEND_PREFIXES = (
    "api/",
    "webhooks",
    "auth",
    "uninstall",
    "docs",
    "redoc",
    "openapi.json",
)


def _is_backend_path(path: str) -> bool:
    p = (path or "").strip("/")
    if not p:
        return False
    if p in ("message", "widget-test", "chatbot-widget.js"):
        return True
    return any(p == pref.rstrip("/") or p.startswith(pref) for pref in _BACKEND_PREFIXES)


@app.get("/chatbot-widget.js")
async def serve_widget():
    app_dir = os.path.dirname(os.path.abspath(__file__))
    project_root = os.path.dirname(app_dir)
    candidates = [
        os.path.join(project_root, "AI-Assistant", "public", "chatbot-widget.js"),
        os.path.join(app_dir, "AI-Assistant", "public", "chatbot-widget.js"),
    ]
    for widget_path in candidates:
        widget_path = os.path.abspath(widget_path)
        if os.path.exists(widget_path):
            return FileResponse(widget_path, media_type="application/javascript")

    return {"error": "Widget not found. Expected AI-Assistant/public/chatbot-widget.js"}


@app.get("/widget-test")
def widget_test():
    return {"message": "Widget endpoint is working!"}


@app.get("/message")
def read_root():
    return {"message": "Welcome to the Shopify AI Assistant!"}


@app.get("/")
async def root(request: Request):
    """Shopify install redirect OR serve React app home."""
    shop = request.query_params.get("shop")
    hmac = request.query_params.get("hmac")
    host = request.query_params.get("host")
    timestamp = request.query_params.get("timestamp")
    print("shop:", shop)

    if shop and hmac:
        redirect_url = f"/auth?shop={shop}&host={host}&hmac={hmac}&timestamp={timestamp}"
        return RedirectResponse(url=redirect_url)

    if FRONTEND_DIR:
        return _serve_index()

    return {
        "message": "Shopify AI Assistant API is running",
        "status": "active",
        "hint": "Build the admin UI: cd AI-Assistant && npm run build",
        "endpoints": {
            "auth": "/auth",
            "auth_callback": "/auth/callback/",
            "uninstall": "/uninstall",
        },
    }


@app.get("/{full_path:path}")
async def serve_spa(request: Request, full_path: str):
    """
    SPA fallback — React Router handles /dashboard, /product-sync, etc.
    Must be registered after all other GET routes.
    """
    if _is_backend_path(full_path):
        raise HTTPException(status_code=404, detail="Not Found")

    if not FRONTEND_DIR:
        raise HTTPException(
            status_code=503,
            detail="Frontend not built. Run: cd AI-Assistant && npm run build",
        )

    safe_path = os.path.normpath(full_path).lstrip(os.sep)
    if ".." not in safe_path:
        file_path = os.path.join(FRONTEND_DIR, safe_path)
        if os.path.isfile(file_path):
            return FileResponse(file_path)

    return _serve_index()


# ── Database — auto-create tables on startup ────────────────────────────────
@app.on_event("startup")
def create_tables():
    from app.core.config import Config
    from app.models import products, store, sync_log, chat, chatbot_config  # noqa: F401
    from app.models import main_database, chat_intent_log  # noqa: F401
    from app.services.db_migrations import run_startup_migrations

    try:
        Base.metadata.create_all(bind=engine)
        run_startup_migrations(engine)
        logger.info("Database tables verified/created successfully.")
    except Exception as e:
        logger.error(
            "Database startup failed: %s — check MYSQL_HOST, MYSQL_PORT (%s).",
            e,
            Config.SQLALCHEMY_DATABASE_URI.split("@")[-1].split("/")[0],
        )
        raise


# ── CORS ────────────────────────────────────────────────────────────────────
app.add_middleware(
    CORSMiddleware,
    allow_origins=["*"],
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)
